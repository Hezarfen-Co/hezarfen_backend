# systemd USER unit running the whole stack via podman compose (replaces the
# old bare-binary unit). Files expected in %h/hezarfen_backend:
#   compose.yaml                from the deploy artifact
#   hezarfen_backend.env        0600, written ONCE BY HAND from
#                               deploy/hezarfen_backend.env.example — the
#                               deploy never creates or overwrites it
#   stack.env                   deploy-owned; carries HEZARFEN_TAG
#   backup-postgres.sh          from the deploy artifact (0755)
#
# Required hezarfen_backend.env keys (full docs in
# deploy/hezarfen_backend.env.example):
#   POSTGRES_USER/PASSWORD/DB   first-boot postgres credentials;
#                               POSTGRES_PASSWORD is baked into the pgdata
#                               volume on the FIRST up and must be URL-safe
#                               (no @ : / — it is interpolated into
#                               DATABASE_URL)
#   BUILDER_USERNAME/PASSWORD   first-boot operator seed
#   COOKIE_SECURE               true behind TLS
#   TRUST_PROXY                 true behind the reverse proxy
#   CORS_ALLOWED_ORIGINS        the browser frontends' origins
#   AI_QUIC_ADDR/AI_SHARED_TOKEN  the QUIC AI bridge
#   OTEL_*                      OTLP export to http://openobserve:5081
#   ZO_ROOT_USER_EMAIL/PASSWORD OpenObserve first-boot root account
#   DEPLOY_ENV                  production
#
# Env-only restart (restart re-runs `compose up -d`, recreating containers
# whose environment changed):
#   systemctl --user restart hezarfen_backend_compose

[Unit]
Description=Hezarfen backend compose stack (postgres + backend + openobserve)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/hezarfen_backend
# ORTAM IKI KANALDAN GELIR -- bu bir tercih degil, saglayicinin siniridir:
#   * operatorun ayar dosyasi -> `EnvironmentFile=` (systemd dosyayi unit'in
#     ORTAMINA koyar; compose interpolasyonu ORTAM DEGISKENLERINE bakar)
#   * deploy sahipli stack.env (HEZARFEN_TAG) -> tek `--env-file`
#
# NEDEN: `podman compose --env-file A --env-file B` bu saglayicida A'yi HIC
# OKUMAZ. `--env-file` tek degerli bir argumandir (podman_compose.py:2941-2946)
# ve yalniz SON dosya cozulur (:2559 `dotenv_path = os.path.realpath(args.env_file)`).
# Iki dosyali eski cagri operator dosyasini tamamen dusuruyordu: stack compose
# varsayilanlariyla kosuyordu (`DATABASE_URL` parolasi `hezarfen`, kopru tokeni
# `change-me`) ve dosyadaki degerler HIC okunmuyordu -- deploy'un
# "POSTGRES_PASSWORD bos olamaz" kapisi dosyayi denetlerken compose onu
# kullanmadigi icin bu sessiz kaliyordu (canlida yasandi, 2026-09-17). Docker
# Compose v2'nin "sonraki dosya cakisan anahtarda kazanir" davranisi bu
# saglayici icin GECERLI DEGIL. Ortam degiskeni --env-file degerlerini EZER
# (:2562), yani iki kanal cakismaz.
EnvironmentFile=%h/hezarfen_backend/hezarfen_backend.env
# Tek --env-file: yalniz deploy sahipli stack.env (HEZARFEN_TAG).
ExecStart=/usr/bin/podman compose --env-file %h/hezarfen_backend/stack.env up -d --no-build
# No -v: named volumes must survive stop. (`EnvironmentFile=` yukarida oldugu
# icin burada da gerekli degiskenler ortamdadir; saglayici eksik env dosyasini
# bos sozluk sayar -- podman_compose.py:2247-2250.)
ExecStop=/usr/bin/podman compose --env-file %h/hezarfen_backend/stack.env down
TimeoutStartSec=180

[Install]
WantedBy=default.target
