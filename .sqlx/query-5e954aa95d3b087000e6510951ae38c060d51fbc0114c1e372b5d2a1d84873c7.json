  "query": "SELECT a.id AS \"id: AppointmentId\", a.slot AS \"slot: AppointmentSlotId\", a.requester AS \"requester: UserId\", a.status AS \"status: AppointmentStatus\", a.reason AS \"reason: AppointmentReason\", a.proposed_starts_at AS \"proposed_starts_at: Timestamp\", a.proposed_ends_at AS \"proposed_ends_at: Timestamp\", a.proposed_by AS \"proposed_by: UserId\", a.decided_by AS \"decided_by: UserId\", a.cancelled_by AS \"cancelled_by: UserId\", a.cancel_reason AS \"cancel_reason: AppointmentReason\", a.reject_reason AS \"reject_reason: AppointmentReason\", a.created_at AS \"created_at: Timestamp\" FROM appointment a JOIN appointment_slot s ON a.slot = s.id WHERE s.teacher = $1 ORDER BY a.id DESC LIMIT $2 OFFSET $3",
