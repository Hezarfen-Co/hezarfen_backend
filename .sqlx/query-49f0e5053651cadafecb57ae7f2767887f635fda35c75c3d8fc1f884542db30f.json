  "db_name": "PostgreSQL",
  "query": "WITH seat AS (\n             UPDATE app_user SET rag_thread_count = rag_thread_count + 1\n             WHERE id = $1\n               AND rag_thread_count < COALESCE(\n                     (SELECT max_chatbot_threads FROM settings WHERE id = 'school'),\n                     $2)\n             RETURNING 1)\n         INSERT INTO rag_thread (id, owner, title, created_at, updated_at)\n         SELECT $3, $1, $4, $5, $5\n         WHERE EXISTS (SELECT 1 FROM seat)\n         RETURNING id AS \"id: RagThreadId\", owner AS \"owner: UserId\", title AS \"title: RagThreadTitle\", created_at AS \"created_at: Timestamp\", updated_at AS \"updated_at: Timestamp\"",
