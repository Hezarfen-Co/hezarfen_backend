  "query": "SELECT id AS \"id: BoardStrokeId\", board AS \"board: BoardId\",\n               author AS \"author: UserId\", kind, payload, count, epoch,\n               created_at AS \"created_at: Timestamp\"\n               FROM board_stroke\n               WHERE board = $1 AND epoch = $2 AND kind = $3 AND id > $4\n               ORDER BY id LIMIT $5",
